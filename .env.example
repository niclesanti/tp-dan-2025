# ╔════════════════════════════════════════════════════════════════════╗
# ║ Environment Variables - Development                               ║
# ║                                                                    ║
# ║ IMPORTANTE: Este archivo contiene valores por defecto para        ║
# ║ desarrollo. Para producción, crear .env.prod con valores seguros. ║
# ║                                                                    ║
# ║ NUNCA commitear archivos .env con credenciales reales a Git.      ║
# ╚════════════════════════════════════════════════════════════════════╝

# ── MySQL Configuration ───────────────────────────────────────────
MYSQL_DATABASE=users
MYSQL_USER=usr_app
MYSQL_PASSWORD=usrapp
MYSQL_ROOT_PASSWORD=rootpwd

# ── PostgreSQL Configuration ──────────────────────────────────────
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppwd

# ── RabbitMQ Configuration ────────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# ── PgAdmin Configuration ─────────────────────────────────────────
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# ── MongoDB Configuration ───────────────────────────────────────────
MONGO_USER=root
MONGO_PASSWORD=rootpwd
MONGO_DB=reservas

# ── Spring Profile ────────────────────────────────────────────────
SPRING_PROFILE=dev,eureka

# ── Application Configuration ─────────────────────────────────────
# TZ=America/Argentina/Cordoba
# LOG_LEVEL=DEBUG
